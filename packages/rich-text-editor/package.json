{
  "name": "@standhigher/shopify-rich-text-editor",
  "version": "0.2.0",
  "type": "module",
  "description": "React rich text editor for Shopify Apps, built with Tiptap 3, Shopify Polaris, and Shopify image upload hooks.",
  "license": "MIT",
  "author": "Standhigher",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standhigher/shopify-rich-text-editor.git",
    "directory": "packages/rich-text-editor"
  },
  "bugs": {
    "url": "https://github.com/standhigher/shopify-rich-text-editor/issues"
  },
  "homepage": "https://github.com/standhigher/shopify-rich-text-editor#readme",
  "keywords": [
    "shopify",
    "shopify-app",
    "shopify-admin",
    "shopify-polaris",
    "polaris",
    "tiptap",
    "tiptap-3",
    "rich-text-editor",
    "wysiwyg",
    "react",
    "react-component",
    "nextjs",
    "typescript",
    "ecommerce",
    "product-description",
    "content-editing",
    "json-editor",
    "shopify-image-upload"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "prepack": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-underline": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "lucide-react": "^0.475.0"
  },
  "peerDependencies": {
    "@shopify/polaris": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@shopify/polaris": "^12.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
