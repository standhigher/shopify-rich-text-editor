{
  "name": "@standhigher/shopify-rich-text-server",
  "version": "0.4.0",
  "type": "module",
  "description": "Server utilities for validating Tiptap JSON, sanitizing rich text HTML, and rendering Shopify-safe output.",
  "license": "MIT",
  "author": "Standhigher",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standhigher/shopify-rich-text-editor.git",
    "directory": "packages/rich-text-server"
  },
  "bugs": {
    "url": "https://github.com/standhigher/shopify-rich-text-editor/issues"
  },
  "homepage": "https://github.com/standhigher/shopify-rich-text-editor#readme",
  "keywords": [
    "shopify",
    "shopify-app",
    "shopify-admin",
    "tiptap",
    "tiptap-3",
    "rich-text",
    "rich-text-editor",
    "sanitize-html",
    "server",
    "typescript",
    "node",
    "html-sanitizer",
    "content-rendering",
    "ecommerce",
    "product-description",
    "json-to-html",
    "shopify-html"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standhigher/shopify-rich-text-core": "workspace:*",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-underline": "^3.0.0",
    "@tiptap/html": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "sanitize-html": "^2.14.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.13.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
